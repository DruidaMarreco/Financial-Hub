# ============================================
# Financial Hub - Environment Configuration
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_USER=postgres
DB_PASSWORD=your_secure_database_password
DB_NAME=financial_hub
DATABASE_URL=postgresql://postgres:your_secure_database_password@postgres:5432/financial_hub

# ============================================
# API CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3001

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=https://your-domain.com/api
FRONTEND_URL=https://your-domain.com

# ============================================
# EXTERNAL SERVICES - BANK AGGREGATION
# ============================================

# Plaid (https://plaid.com) - For bank account aggregation
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox # sandbox, development, or production
PLAID_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# EXTERNAL SERVICES - CRYPTOCURRENCY
# ============================================

# Etherscan API (optional - for Ethereum wallet tracking)
ETHERSCAN_API_KEY=optional_etherscan_api_key

# ============================================
# EXTERNAL SERVICES - STOCKS
# ============================================

# Alpha Vantage API (optional - for stock quotes)
ALPHA_VANTAGE_API_KEY=optional_alpha_vantage_api_key

# ============================================
# EXTERNAL SERVICES - REAL ESTATE
# ============================================

# Zillow API (optional - for property valuations)
ZILLOW_API_KEY=optional_zillow_api_key

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info # error, warn, info, debug

# Optional: Error tracking (Sentry)
# SENTRY_DSN=https://your_sentry_dsn

# ============================================
# SECURITY
# ============================================

# CORS allowed origins
CORS_ORIGIN=https://your-domain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session timeout (milliseconds, 24 hours)
SESSION_TIMEOUT=86400000

# ============================================
# OPTIONAL: CACHING & PERFORMANCE
# ============================================

# Redis (optional - for caching)
# REDIS_URL=redis://redis:6379

# ============================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ============================================

# SMTP Configuration (optional - for email alerts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=Financial Hub <noreply@yourdomain.com>

# ============================================
# OPTIONAL: TIMEZONE & LOCALIZATION
# ============================================
TZ=UTC

# ============================================
# DEPLOYMENT SETTINGS
# ============================================

# Raspberry Pi / Docker specific
DOCKER=true

# ============================================
# DEVELOPMENT ONLY (not for production)
# ============================================
# DEBUG=financial-hub:*
