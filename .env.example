# Database
DATABASE_URL=postgresql://user:password@localhost:5432/financial_hub

# JWT Authentication
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_EXPIRATION=24h

# Revolut Integration
# Get from: https://developer.revolut.com
REVOLUT_CLIENT_ID=your_client_id
REVOLUT_CLIENT_SECRET=your_client_secret
REVOLUT_REDIRECT_URI=http://localhost:3000/integrations/revolut/callback

# CGD (Caixa Geral de Depósitos) Integration
# Get from: https://developers.cgd.pt
CGD_CLIENT_ID=your_client_id
CGD_CLIENT_SECRET=your_client_secret
CGD_REDIRECT_URI=http://localhost:3000/integrations/cgd/callback

# Edenred (Meal Cards) Integration
# Get from: https://developers.edenred.com
EDENRED_CLIENT_ID=your_client_id
EDENRED_CLIENT_SECRET=your_client_secret
EDENRED_REDIRECT_URI=http://localhost:3000/integrations/edenred/callback

# Encryption
ENCRYPTION_KEY=min-32-character-encryption-key

# Environment
NODE_ENV=development
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
