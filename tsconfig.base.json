{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@financial-hub/api/*": ["apps/api/src/*"],
      "@financial-hub/web/*": ["apps/web/src/*"],
      "@financial-hub/core/*": ["libs/core/src/*"],
      "@financial-hub/data/*": ["libs/data/src/*"],
      "@financial-hub/common/*": ["libs/common/src/*"]
    },
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve"
  }
}
